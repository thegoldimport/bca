{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buildcustom-control-plane-production",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./dist/public", "not_found_handling": "single-page-application" },
  "d1_databases": [{ "binding": "DB", "database_name": "buildcustom-control-plane-production", "database_id": "43bb3095-0d1e-4a25-97ef-edbd6c5d6df0", "migrations_dir": "migrations/d1" }],
  "kv_namespaces": [{ "binding": "STAGING_ROUTES", "id": "d6e19823343e46d3965ad167775afb30" }],
  "services": [{ "binding": "VIBESDK_RUNTIME", "service": "buildcustom-vibesdk-staging" }],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "STAGING_RUNTIME_URL": "https://buildcustom-vibesdk-staging.thegoldimport.workers.dev",
    "VIBESDK_RUNTIME_URL": "https://buildcustom-vibesdk-staging.thegoldimport.workers.dev",
    "CONTROL_PLANE_ROUTE_KV_ID": "d6e19823343e46d3965ad167775afb30",
    "CONTROL_PLANE_DISPATCH_NAMESPACE": "buildcustom-vibesdk-staging",
    "CONTROL_PLANE_ALLOWED_ORIGIN": "https://buildcustom-control-plane-production.thegoldimport.workers.dev",
    "STAGING_ROUTE_KV_ID": "d6e19823343e46d3965ad167775afb30",
    "STAGING_DISPATCH_NAMESPACE": "buildcustom-vibesdk-staging",
    "STAGING_ALLOWED_ORIGIN": "https://buildcustom-control-plane-production.thegoldimport.workers.dev",
    "STAGING_LOGIN_ENABLED": "true",
    "STAGING_REGISTRATION_ENABLED": "false",
    "RUNTIME_OPERATIONS_ENABLED": "false"
  }
}