{
	"name": "vibesdk-test",
	"compatibility_date": "2024-12-12",
	"main": "worker/index.ts",
	"compatibility_flags": ["nodejs_compat"],
	"send_metrics": false,
	"d1_databases": [
		{
			"binding": "AUTH_TEST_DB",
			"database_name": "auth-attempt-window-test",
			"database_id": "00000000-0000-0000-0000-000000000001"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "UserSecretsStore",
				"name": "UserSecretsStore"
			},
			{
				"class_name": "FsHarnessDO",
				"name": "FsHarnessDO"
			}
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"UserSecretsStore"
			],
			"tag": "v1"
		},
		{
			"new_sqlite_classes": [
				"FsHarnessDO"
			],
			"tag": "v2"
		}
	],
	"vars": {}
}
