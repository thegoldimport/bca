  "queries": [
    {
      "sql": "SELECT id,role,created_at,length(content) AS bytes,CASE WHEN role='user' AND instr(content,'__THINK_INTERNAL_CONTINUATION__:')>0 THEN 1 ELSE 0 END AS internal_continuation FROM assistant_messages ORDER BY created_at,id"
    },
    {
      "sql": "SELECT request_id,status,created_at,completed_at FROM cf_ai_chat_stream_metadata"
    },
    {
      "sql": "SELECT json_extract(j.value,'$.toolName') AS name,json_extract(j.value,'$.state') AS state,json_extract(j.value,'$.toolCallId') AS call_id,json_extract(j.value,'$.output.status') AS output_status,json_extract(j.value,'$.errorText') AS error_text FROM assistant_messages m,json_each(m.content,'$.parts') j WHERE m.role='assistant' AND json_extract(j.value,'$.type') LIKE 'tool-%'"
    },
    {
      "sql": "SELECT json_extract(e.value,'$.type') AS chunk_type,count(*) AS n FROM cf_ai_chat_stream_chunks c,json_each(CASE WHEN json_type(c.body)='array' THEN c.body ELSE json_array(c.body) END) e GROUP BY 1"
    },
    {
      "sql": "SELECT json_extract(e.value,'$.type') AS chunk_type,json_extract(e.value,'$.errorText') AS error_text FROM cf_ai_chat_stream_chunks c,json_each(CASE WHEN json_type(c.body)='array' THEN c.body ELSE json_array(c.body) END) e WHERE json_extract(e.value,'$.type') IN ('error','tool-output-error','tool-input-error')"
    }
  ],
