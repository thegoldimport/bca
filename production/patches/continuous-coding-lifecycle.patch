+function sameThinkPreviewNavigationUrl(actual: string, configured: string): boolean {
+	try {
+		const actualUrl = new URL(actual);
+		const configuredUrl = new URL(configured);
+		return (
+			actualUrl.protocol === configuredUrl.protocol &&
+			actualUrl.origin === configuredUrl.origin &&
+			actualUrl.pathname === configuredUrl.pathname &&
+			actualUrl.username === configuredUrl.username &&
+			actualUrl.password === configuredUrl.password
+		);
+	} catch {
+		return false;
+	}
+}
+
+function hasExactSignedPreviewRequest(actual: string, configured: string): boolean {
+	try {
+		const actualUrl = new URL(actual);
+		const configuredUrl = new URL(configured);
+		return (
+			actualUrl.protocol === configuredUrl.protocol &&
+			actualUrl.origin === configuredUrl.origin &&
+			actualUrl.pathname === configuredUrl.pathname &&
+			actualUrl.search === configuredUrl.search &&
+			actualUrl.hash === configuredUrl.hash &&
+			actualUrl.username === configuredUrl.username &&
+			actualUrl.password === configuredUrl.password
+		);
+	} catch {
+		return false;
+	}
+}
+
+export function isThinkBrowserCaptureClean(
+	value: unknown,
+	configuredPreviewUrl?: string,
+): boolean {
+	if (!configuredPreviewUrl || !value || typeof value !== 'object') return false;
+	const result = value as Record<string, unknown>;
+	const logs = result.logs;
+	const pageErrors = result.page_errors;
+	const requestFailures = result.request_failures;
+	const totals = result.totals;
+	if (
+		result.error ||
+		result.warning ||
+		result.truncated !== false ||
+		typeof result.url !== 'string' ||
+		!hasExactSignedPreviewRequest(result.url, configuredPreviewUrl) ||
+		typeof result.final_url !== 'string' ||
+		!sameThinkPreviewNavigationUrl(result.final_url, configuredPreviewUrl) ||
+		!Array.isArray(logs) ||
+		!Array.isArray(pageErrors) ||
+		!Array.isArray(requestFailures) ||
+		!totals ||
+		typeof totals !== 'object'
+	) return false;
+
+	const fullTotals = totals as Record<string, unknown>;
+	const isCount = (count: unknown): count is number =>
+		typeof count === 'number' && Number.isSafeInteger(count) && count >= 0;
+	if (
+		!isCount(fullTotals.logs) ||
+		!isCount(fullTotals.page_errors) ||
+		!isCount(fullTotals.request_failures) ||
+		fullTotals.logs !== logs.length ||
+		fullTotals.page_errors !== pageErrors.length ||
+		fullTotals.request_failures !== requestFailures.length ||
+		fullTotals.page_errors !== 0 ||
+		fullTotals.request_failures !== 0
+	) return false;
+
+	return (
+		pageErrors.length === 0 &&
+		requestFailures.length === 0 &&
+		!logs.some((entry) =>
+			!entry ||
+			typeof entry !== 'object' ||
+			typeof (entry as { level?: unknown }).level !== 'string' ||
+			(entry as { level?: unknown }).level === 'error',
+		)
+	);
+}
