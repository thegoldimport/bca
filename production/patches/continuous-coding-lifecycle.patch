+import { describe, expect, it, vi } from 'vitest';
+import { createDeploySpaceTool } from './deploy-tool';
+import type { SpaceWorkspaceStub } from './space-workspace-ops';
+
+function invokeDeploy(stub: Partial<SpaceWorkspaceStub>) {
+	const getStub = vi.fn(() => stub as SpaceWorkspaceStub);
+	const deployTool = createDeploySpaceTool({ getStub });
+	return {
+		getStub,
+		run: (deployTool as unknown as {
+			execute: (args: { branch?: string }) => Promise<string>;
+		}).execute({ branch: 'main' }),
+	};
+}
+
+describe('deploy_space preflight ordering', () => {
+	it('does not commit or deploy when working-tree preflight rejects malformed JSX', async () => {
+		const preflightCommitDeploy = vi.fn(async () => ({
+			ok: false as const,
+			phase: 'preflight' as const,
+			error: 'Invalid static JSX/TSX in public/app.jsx',
+		}));
+		const { getStub, run } = invokeDeploy({ preflightCommitDeploy });
+
+		const result = JSON.parse(await run);
+		expect(result.error).toContain('Preflight failed');
+		expect(result.error).toContain('public/app.jsx');
+		expect(preflightCommitDeploy).toHaveBeenCalledOnce();
+		expect(getStub).toHaveBeenCalledOnce();
+	});
+
+	it('commits and deploys repaired source through one atomic RPC', async () => {
+		let malformedSource = true;
+		const preflightCommitDeploy = vi.fn(async () => {
+			if (malformedSource) {
+				return {
+					ok: false as const,
+					phase: 'preflight' as const,
+					error: 'Invalid static JSX/TSX in public/app.jsx',
+				};
+			}
+			return { ok: true as const, preview_url: '/preview', commit_hash: 'commit-1' };
+		});
+		const { run } = invokeDeploy({ preflightCommitDeploy });
+
+		const firstResult = JSON.parse(await run);
+		expect(firstResult.error).toContain('Preflight failed');
+
+		// Repair the working-tree source and invoke deploy again.
+		malformedSource = false;
+		const result = JSON.parse(await invokeDeploy({ preflightCommitDeploy }).run);
+		expect(result.preview_url).toBe('/preview');
+		expect(preflightCommitDeploy).toHaveBeenCalledTimes(2);
+	});
+
+	it('does not treat a real gitCommit failure as a clean tree', async () => {
+		const preflightCommitDeploy = vi.fn(async () => ({
+			ok: false as const,
+			phase: 'commit' as const,
+			error: 'disk write failed',
+		}));
+		const { run } = invokeDeploy({ preflightCommitDeploy });
+
+		const result = JSON.parse(await run);
+		expect(result.error).toContain('Commit failed');
+		expect(result.error).toContain('disk write failed');
+	});
+
+	it('keeps clean-tree deploy behavior without creating an empty commit', async () => {
+		const preflightCommitDeploy = vi.fn(async () => ({
+			ok: true as const,
+			preview_url: '/preview',
+			commit_hash: 'existing-head',
+		}));
+		const { run } = invokeDeploy({ preflightCommitDeploy });
+
+		const result = JSON.parse(await run);
+		expect(result.preview_url).toBe('/preview');
+		expect(result.commit_hash).toBe('existing-head');
+		expect(preflightCommitDeploy).toHaveBeenCalledOnce();
+	});
+});
