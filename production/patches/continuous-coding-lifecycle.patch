+
+const configuredUrl = 'https://preview.example/space/app/preview/main/?token=signed';
+
+function capture(overrides: Record<string, unknown> = {}) {
+	return {
+		url: configuredUrl,
+		final_url: 'https://preview.example/space/app/preview/main/',
+		truncated: false,
+		logs: [{ level: 'info', text: 'App loaded.' }],
+		page_errors: [],
+		request_failures: [],
+		totals: { logs: 1, page_errors: 0, request_failures: 0 },
+		...overrides,
+	};
+}
+
+describe('Think browser evidence integrity', () => {
+	it('accepts the exact signed request when the final navigation stays on the same protocol, origin, and path', () => {
+		expect(isThinkBrowserCaptureClean(capture(), configuredUrl)).toBe(true);
+	});
+
+	it.each([
+		['different origin', 'https://attacker.example/space/app/preview/main/'],
+		['different protocol', 'http://preview.example/space/app/preview/main/'],
+		['different path', 'https://preview.example/space/app/preview/staging/'],
+	])('rejects a final navigation with a %s', (_label, finalUrl) => {
+		expect(isThinkBrowserCaptureClean(capture({ final_url: finalUrl }), configuredUrl)).toBe(false);
+	});
+
+	it('rejects truncated diagnostics even when the returned arrays contain no errors', () => {
+		expect(isThinkBrowserCaptureClean(capture({
+			truncated: true,
+			totals: { logs: 100, page_errors: 0, request_failures: 0 },
+		}), configuredUrl)).toBe(false);
+	});
+
+	it('rejects full error counts even when capped diagnostic arrays are empty', () => {
+		expect(isThinkBrowserCaptureClean(capture({
+			page_errors: [],
+			totals: { logs: 1, page_errors: 2, request_failures: 0 },
+		}), configuredUrl)).toBe(false);
+		expect(isThinkBrowserCaptureClean(capture({
+			request_failures: [],
+			totals: { logs: 1, page_errors: 0, request_failures: 1 },
+		}), configuredUrl)).toBe(false);
+	});
+
+	it('rejects console errors, mismatched signed request URLs, and missing full-count evidence', () => {
+		expect(isThinkBrowserCaptureClean(capture({
+			logs: [{ level: 'error', text: 'Runtime error.' }],
+			totals: { logs: 1, page_errors: 0, request_failures: 0 },
+		}), configuredUrl)).toBe(false);
+		expect(isThinkBrowserCaptureClean(capture({
+			url: 'https://preview.example/space/app/preview/main/?token=other',
+		}), configuredUrl)).toBe(false);
+		expect(isThinkBrowserCaptureClean(capture({ totals: undefined }), configuredUrl)).toBe(false);
+		expect(isThinkBrowserCaptureClean(capture({ final_url: undefined }), configuredUrl)).toBe(false);
