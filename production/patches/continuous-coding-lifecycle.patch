+import { describe, expect, it, vi } from "vitest"
+import * as deployEngine from "./deploy-engine"
+import * as gitObjects from "./git-objects"
+import type { BranchDeploymentBundle, DeployContext } from "./deploy-engine"
+import { SpaceDO } from "./durable-object"
+import { ArtifactsBackend } from "./fs-backend"
+
+function workspaceContext(source: string): DeployContext {
+  const files: Record<string, string> = {
+    "/wrangler.json": JSON.stringify({ main: "src/index.tsx", compatibility_date: "2025-04-01" }),
+    "/src/index.tsx": source,
+  }
+  const git = {
+    checkout: vi.fn(async () => {
+      throw new Error("preflight must not checkout")
+    }),
+    log: vi.fn(async () => {
+      throw new Error("preflight must not read branch history")
+    }),
+  }
+  const fs = {
+    glob: vi.fn(async () => Object.keys(files)),
+    stat: vi.fn(async () => ({ type: "file", size: 1, mtime: new Date() })),
+    readFile: vi.fn(async (path: string) => {
+      const content = files[path]
+      if (content === undefined) throw new Error(`missing ${path}`)
+      return content
+    }),
+  }
+  return {
+    git: git as never,
+    fs: fs as never,
+    sql: {} as never,
+    readWorkspaceSnapshot: async () =>
+      Object.fromEntries(Object.entries(files).map(([path, content]) => [path.slice(1), content])),
+  }
+}
+
+function workspaceSnapshot(files: Record<string, string>) {
+  const encoder = new TextEncoder()
+  return {
+    files,
+    bytes: Object.fromEntries(
+      Object.entries(files).map(([path, content]) => [path, encoder.encode(content)]),
+    ),
+  }
+}
