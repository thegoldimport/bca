new file mode 100644
index 0000000..9aa3edb
--- /dev/null
+++ b/worker/agents/think/user-approved-continuation.test.ts
@@ -0,0 +1,80 @@
+import { describe, expect, it } from 'vitest';
+import { createThinkTaskOperation, advanceThinkTaskOperation } from './finish-task-tool';
+import {
+assertContinuationApproval, createApprovedThinkOperation, customerTaskStatus,
+isConversationalContinuation,
+} from './user-approved-continuation';
+
+// Sandboxed lifecycle simulation. No real runtime, credentials, or model calls.
+const limits = {
+maxContinuations: 4, maxCredits: 250, maxElapsedMs: 900000,
+maxModelCalls: 650, maxToolCalls: 1300,
+};
+const exhausted = {
+status: 'INCOMPLETE_RESOURCE_LIMIT' as const,
+reason: 'continuation_budget_exhausted', summary: 'Internal diagnostic', updatedAt: 1,
+};
+describe('customer-approved bounded work sessions', () => {
+it('offers Continue at an unfinished autonomous boundary', () => {
+expect(customerTaskStatus(exhausted)).toBe('CONTINUE_AVAILABLE');
+expect(exhausted.reason).toBe('continuation_budget_exhausted');
+});
+it('retains task, conversation, intent and policy while clearing usage', () => {
+const previous = {
+...createThinkTaskOperation('o1', 'same-conversation', limits),
+originalIntent: 'Repair persistence', creditsConsumed: 250, modelCalls: 100,
+toolCalls: 70, continuationCount: 4, completedPassCount: 5,
+resourceLimitReason: 'credit_limit' as const, resourceLimitAt: 1,
+};
+const next = createApprovedThinkOperation(previous, 'o2');
+expect(next).toMatchObject({
+taskId: 'o2', customerTaskId: 'o1', parentOperationId: 'o1',
+conversationId: 'same-conversation', originalIntent: 'Repair persistence',
+creditsConsumed: 0, modelCalls: 0, toolCalls: 0,
+continuationCount: 0, completedPassCount: 0, limits,
+});
+expect(next.resourceLimitReason).toBeUndefined();
+expect(next.startedAt).toBeGreaterThan(1);
+});
+it('retains one operation and cumulative allowance for internal continuation', () => {
+const session = createThinkTaskOperation('o2', 'conversation', limits);
+session.creditsConsumed = 12;
+const nextPass = advanceThinkTaskOperation(session);
+expect(nextPass.taskId).toBe('o2');
+expect(nextPass.startedAt).toBe(session.startedAt);
+expect(nextPass.creditsConsumed).toBe(12);
+});
+it('permits successive bounded sessions for the same task', () => {
+const first = createThinkTaskOperation('o1', 'conversation', limits);
+const second = createApprovedThinkOperation(first, 'o2');
+const third = createApprovedThinkOperation(second, 'o3');
+expect(third.customerTaskId).toBe('o1');
+expect(third.parentOperationId).toBe('o2');
+expect(third.limits).toEqual(limits);
+});
+it('never presents unfinished, blocked, or input-required work as complete', () => {
+for (const status of ['RUNNING', 'BLOCKED', 'USER_INPUT_REQUIRED'] as const) {
+expect(customerTaskStatus({ ...exhausted, status })).not.toBe('BUILD_COMPLETE');
+}
+expect(customerTaskStatus({ ...exhausted, status: 'COMPLETE' })).toBe('BUILD_COMPLETE');
+expect(customerTaskStatus({ ...exhausted, status: 'USER_INPUT_REQUIRED' })).toBe('NEEDS_INPUT');
+});
+it('does not bypass account credits, unknown stops, or stale task ownership', () => {
+expect(customerTaskStatus({ ...exhausted, reason: 'available_credits_limit' })).toBe('STOPPED');
+expect(customerTaskStatus({ ...exhausted, reason: 'unknown' })).toBe('STOPPED');
+const operation = createThinkTaskOperation('o1', 'conversation', limits);
+expect(() => assertContinuationApproval(operation, exhausted, {
+taskId: 'other-task', operationId: 'o1',
+})).toThrow();
+expect(() => assertContinuationApproval(operation, { ...exhausted, status: 'COMPLETE' }, {
+taskId: 'o1', operationId: 'o1',
+})).toThrow();
+});
+it('recognizes only deliberate short conversational approval', () => {
+for (const phrase of ['yes', 'continue', 'Keep going!', 'go ahead', 'finish it', 'keep working']) {
+expect(isConversationalContinuation(phrase)).toBe(true);
+}
+expect(isConversationalContinuation('Yes, add a settings page instead')).toBe(false);
+expect(isConversationalContinuation('Actually forget that')).toBe(false);
+});
+});
