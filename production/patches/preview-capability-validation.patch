@@ -0,0 +1,48 @@
+import { WorkerEntrypoint } from 'cloudflare:workers';
+import { validateSpacePreviewCapability } from './space-preview';
+
+export interface PreviewCapabilityValidationInput {
+	agentId: string;
+	branch: string;
+	token: string;
+}
+
+export interface PreviewCapabilityValidationResult {
+	valid: boolean;
+}
+
+/**
+ * Private service-binding RPC for validating a preview bearer without
+ * dispatching the request to its generated application.
+ */
+export class PreviewCapabilityValidator extends WorkerEntrypoint<Env> {
+	async validatePreviewCapability(
+		input: PreviewCapabilityValidationInput,
+	): Promise<PreviewCapabilityValidationResult> {
+		const candidate = input as unknown as Partial<PreviewCapabilityValidationInput> | null;
+		if (
+			!candidate
+			|| typeof candidate.agentId !== 'string'
+			|| !candidate.agentId
+			|| typeof candidate.branch !== 'string'
+			|| !candidate.branch
+			|| typeof candidate.token !== 'string'
+			|| !candidate.token
+		) {
+			return { valid: false };
+		}
+
+		try {
+			const claims = await validateSpacePreviewCapability(
+				this.env,
+				candidate.token,
+				candidate.agentId,
+				candidate.branch,
+			);
+			return { valid: claims !== null };
+		} catch {
+			// An unavailable validation dependency must never grant preview access.
+			return { valid: false };
+		}
+	}
+}
