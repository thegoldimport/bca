+/**
+ * Validate the same bearer used by normal dispatch, without consuming request
+ * rate limit or dispatching to generated-app code.
+ */
+export async function validateSpacePreviewCapability(
+	env: Env,
+	token: string,
+	spaceName: string,
+	branch: string,
+): Promise<SpacePreviewClaims | null> {
+	if (!token) return null;
+	const claims = await verifySpacePreviewToken(env, token, spaceName, branch);
+	if (!claims || !(await isPreviewVersionCurrent(env, spaceName, claims))) return null;
+	return claims;
