+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { AuthController } from './controller';
+import type { RouteContext } from '../../types/route-context';
+
+const {
+	mockLogin,
+	mockValidateTokenAndGetUser,
+	mockRevokeUserSession,
+	sessionRows,
+	tokens,
+	mockGetSessionById,
+} = vi.hoisted(() => ({
+	mockLogin: vi.fn(),
+	mockValidateTokenAndGetUser: vi.fn(),
+	mockRevokeUserSession: vi.fn(),
+	sessionRows: new Map<string, { userId: string; isRevoked: boolean }>(),
+	tokens: new Map<string, { sessionId: string; user: { id: string; email: string } }>(),
+	mockGetSessionById: vi.fn(),
+}));
+
+vi.mock('../../../database/services/AuthService', () => ({
+	AuthService: class {
+		login = mockLogin;
+		validateTokenAndGetUser = mockValidateTokenAndGetUser;
+	},
+}));
+
+vi.mock('../../../database/services/SessionService', () => ({
+	SessionService: class {
+		static config = { sessionTTL: 3600 };
+		revokeUserSession = mockRevokeUserSession;
+		getSessionById = mockGetSessionById;
+	},
+}));
+
+const BASE_URL = 'https://app.local';
+const testEnv = { ENVIRONMENT: 'dev' } as unknown as Env;
+
+function makeContext(overrides: Partial<RouteContext> = {}): RouteContext {
+	return {
+		user: { id: 'user-a', email: 'a@example.com' },
+		sessionId: 'session-a-1',
+		config: {},
+		pathParams: {},
+		queryParams: new URLSearchParams(),
+		...overrides,
+	} as unknown as RouteContext;
+}
+
+async function login(email: string) {
+	const response = await AuthController.login(
+		new Request(`${BASE_URL}/api/auth/login`, {
+			method: 'POST',
+			headers: { 'content-type': 'application/json' },
+			body: JSON.stringify({ email, password: 'valid-test-password' }),
+		}),
+		testEnv,
+		{} as ExecutionContext,
+		makeContext({ user: null, sessionId: null }),
+	);
+
+	expect(response.status).toBe(200);
+	const cookie = response.headers.get('set-cookie') ?? '';
+	const token = cookie.match(/(?:^|,\s*)accessToken=([^;,\s]+)/)?.[1];
+	expect(token).toBeTruthy();
+	const result = await response.json() as {
+		data: { sessionId: string; user: { id: string; email: string } };
+	};
+
+	return { token: token!, ...result.data };
+}
+
+function authCheck(token: string) {
+	return AuthController.checkAuth(
+		new Request(`${BASE_URL}/api/auth/check`, {
+			headers: { cookie: `accessToken=${token}` },
+		}),
+		testEnv,
+		{} as ExecutionContext,
+		makeContext(),
+	);
+}
+
+async function isAuthenticated(token: string): Promise<boolean> {
+	const response = await authCheck(token);
+	expect(response.status).toBe(200);
+	const body = await response.json() as { data: { authenticated: boolean } };
+	return body.data.authenticated;
+}
+
+describe('AuthController.logout session revocation', () => {
+	beforeEach(() => {
+		sessionRows.clear();
+		tokens.clear();
+		mockLogin.mockReset();
+		mockValidateTokenAndGetUser.mockReset();
+		mockRevokeUserSession.mockReset();
+		mockGetSessionById.mockReset();
+
+		mockLogin.mockImplementation(async ({ email }: { email: string }) => {
+			const userId = email === 'a@example.com' ? 'user-a' : 'user-b';
+			const user = { id: userId, email };
+			const sessionId = `session-${sessionRows.size + 1}`;
+			const accessToken = `access-token-${sessionRows.size + 1}`;
+
+			sessionRows.set(sessionId, { userId, isRevoked: false });
+			tokens.set(accessToken, { sessionId, user });
+			return {
+				user,
+				sessionId,
+				accessToken,
+				expiresAt: new Date(Date.now() + 60_000),
+			};
+		});
+
+		mockValidateTokenAndGetUser.mockImplementation(async (token: string) => {
+			const auth = tokens.get(token);
+			const session = auth && sessionRows.get(auth.sessionId);
+			if (!auth || !session || session.isRevoked) return null;
+			return { user: auth.user, sessionId: auth.sessionId };
+		});
+
+		mockRevokeUserSession.mockImplementation(async (sessionId: string, userId: string) => {
+			const session = sessionRows.get(sessionId);
+			if (session?.userId === userId) session.isRevoked = true;
+		});
+		mockGetSessionById.mockImplementation(async (sessionId: string) => {
+			return sessionRows.get(sessionId) ?? null;
+		});
+	});
+
+	it('revokes only the current session, rejects its old token, and preserves fresh and independent sessions', async () => {
+		const sessionA1 = await login('a@example.com');
+		const sessionA2 = await login('a@example.com');
+		const sessionB1 = await login('b@example.com');
+
+		expect(await isAuthenticated(sessionA1.token)).toBe(true);
+		expect(await isAuthenticated(sessionA2.token)).toBe(true);
+		expect(await isAuthenticated(sessionB1.token)).toBe(true);
+		expect(sessionRows.get(sessionA1.sessionId)?.isRevoked).toBe(false);
+
+		const logout = await AuthController.logout(
+			new Request(`${BASE_URL}/api/auth/logout`, {
+				method: 'POST',
+				headers: { cookie: `accessToken=${sessionA1.token}` },
+			}),
+			testEnv,
+			{} as ExecutionContext,
+			makeContext({ user: sessionA1.user, sessionId: sessionA1.sessionId }),
+		);
+
+		expect(logout.status).toBe(200);
+		expect(logout.headers.get('set-cookie')).toContain('Max-Age=0');
+		expect(mockRevokeUserSession).toHaveBeenCalledWith(sessionA1.sessionId, sessionA1.user.id);
+		expect(sessionRows.get(sessionA1.sessionId)?.isRevoked).toBe(true);
+
+		expect(await isAuthenticated(sessionA1.token)).toBe(false);
+		expect(await isAuthenticated(sessionA2.token)).toBe(true);
+		expect(await isAuthenticated(sessionB1.token)).toBe(true);
+
+		const freshLogin = await login('a@example.com');
+		expect(freshLogin.sessionId).not.toBe(sessionA1.sessionId);
+		expect(await isAuthenticated(freshLogin.token)).toBe(true);
+		expect(await isAuthenticated(sessionA1.token)).toBe(false);
+		expect(sessionRows.get(sessionA1.sessionId)?.isRevoked).toBe(true);
+	});
+
+	it('fails closed without an authenticated session and leaves cookies untouched if revocation fails', async () => {
+		const session = await login('a@example.com');
+
+		const missingContext = await AuthController.logout(
+			new Request(`${BASE_URL}/api/auth/logout`, { method: 'POST' }),
+			testEnv,
+			{} as ExecutionContext,
+			makeContext({ user: null, sessionId: null }),
+		);
+		expect(missingContext.status).toBe(401);
+		expect(mockRevokeUserSession).not.toHaveBeenCalled();
+
+		mockRevokeUserSession.mockRejectedValueOnce(new Error('database unavailable'));
+		const failedRevocation = await AuthController.logout(
+			new Request(`${BASE_URL}/api/auth/logout`, {
+				method: 'POST',
+				headers: { cookie: `accessToken=${session.token}` },
+			}),
+			testEnv,
+			{} as ExecutionContext,
+			makeContext({ user: session.user, sessionId: session.sessionId }),
+		);
+		expect(failedRevocation.status).toBe(500);
+		expect(failedRevocation.headers.get('set-cookie')).toBeNull();
+		expect(sessionRows.get(session.sessionId)?.isRevoked).toBe(false);
+	});
+
+	it('rejects a missing or differently owned session without clearing cookies', async () => {
+		const session = await login('a@example.com');
+		sessionRows.delete(session.sessionId);
+
+		const missingSession = await AuthController.logout(
+			new Request(`${BASE_URL}/api/auth/logout`, { method: 'POST' }),
+			testEnv,
+			{} as ExecutionContext,
+			makeContext({ user: session.user, sessionId: session.sessionId }),
+		);
+		expect(missingSession.status).toBe(401);
+		expect(missingSession.headers.get('set-cookie')).toBeNull();
+		expect(mockRevokeUserSession).not.toHaveBeenCalled();
+
+		sessionRows.set(session.sessionId, { userId: session.user.id, isRevoked: false });
+		const mismatchedOwner = await AuthController.logout(
+			new Request(`${BASE_URL}/api/auth/logout`, { method: 'POST' }),
+			testEnv,
+			{} as ExecutionContext,
+			makeContext({ user: { id: 'user-b', email: 'b@example.com' }, sessionId: session.sessionId }),
+		);
+		expect(mismatchedOwner.status).toBe(401);
+		expect(mismatchedOwner.headers.get('set-cookie')).toBeNull();
+		expect(mockRevokeUserSession).not.toHaveBeenCalled();
+		expect(sessionRows.get(session.sessionId)?.isRevoked).toBe(false);
+	});
+
+	it('does not clear cookies when revocation reports success but leaves the session active', async () => {
+		const session = await login('a@example.com');
+		mockRevokeUserSession.mockImplementationOnce(async () => {});
+
+		const response = await AuthController.logout(
+			new Request(`${BASE_URL}/api/auth/logout`, {
+				method: 'POST',
+				headers: { cookie: `accessToken=${session.token}` },
+			}),
+			testEnv,
+			{} as ExecutionContext,
+			makeContext({ user: session.user, sessionId: session.sessionId }),
+		);
+
+		expect(response.status).toBe(500);
+		expect(response.headers.get('set-cookie')).toBeNull();
+		expect(sessionRows.get(session.sessionId)?.isRevoked).toBe(false);
+	});
+
+	it('does not clear cookies if the session disappears during revocation verification', async () => {
+		const session = await login('a@example.com');
+		mockRevokeUserSession.mockImplementationOnce(async (sessionId: string) => {
+			sessionRows.delete(sessionId);
+		});
+
+		const response = await AuthController.logout(
+			new Request(`${BASE_URL}/api/auth/logout`, { method: 'POST' }),
+			testEnv,
+			{} as ExecutionContext,
+			makeContext({ user: session.user, sessionId: session.sessionId }),
+		);
+
+		expect(response.status).toBe(500);
+		expect(response.headers.get('set-cookie')).toBeNull();
+	});
+});
