+} from "./think-restore-sync"
+
+describe("Think restore projection recovery", () => {
+  it("rebuilds text files from SpaceDO and removes stale editor entries", async () => {
+    let state = {
+      generatedFilesMap: {
+        "src/keep.ts": {
+          filePath: "src/keep.ts",
+          fileContents: "old",
+          filePurpose: "Existing purpose",
+          lastDiff: "",
+        },
+        "src/stale.ts": {
+          filePath: "src/stale.ts",
+          fileContents: "stale",
+          filePurpose: "Stale",
+          lastDiff: "",
+        },
+      } as Record<string, FileState>,
+    }
+    const manager = new FileManager(
+      {
+        getState: () => state as unknown as BaseProjectState,
+        setState: (next: BaseProjectState) => {
+          state = next as unknown as typeof state
+        },
+        updateField: () => {},
+      } as unknown as IStateManager<BaseProjectState>,
+      () => ({}) as TemplateDetails,
+      { setOnFilesChangedCallback: () => {} } as unknown as GitVersionControl,
+    )
+    const fileBytes = new Map<string, Uint8Array>([
+      ["src/keep.ts", new TextEncoder().encode("restored keep")],
+      ["src/new.ts", new TextEncoder().encode("new file")],
+      ["public/logo.bin", new Uint8Array([0, 255, 3])],
+    ])
+    const events: Array<{ type: string; payload: unknown }> = []
+    const space = {
+      list: async () => [...fileBytes.keys()].map((path) => ({ path: `/${path}`, mtime: 0 })),
+      readFileBytes: async (path: string) => fileBytes.get(path.replace(/^\/+/, '')) ?? null,
+    }
+
+    await syncRestoredDevelopmentFiles(space, manager, (type, payload) => events.push({ type, payload }))
+
+    expect(Object.keys(state.generatedFilesMap).sort()).toEqual(["src/keep.ts", "src/new.ts"])
+    expect(state.generatedFilesMap["src/keep.ts"]).toMatchObject({
+      fileContents: "restored keep",
+      filePurpose: "Existing purpose",
+    })
+    expect(state.generatedFilesMap["src/new.ts"]?.fileContents).toBe("new file")
+    expect(events).toEqual(expect.arrayContaining([
+      { type: "file_deleted", payload: { filePath: "src/stale.ts" } },
+      expect.objectContaining({ type: "file_generated" }),
+    ]))
+
+    const order: string[] = []
+    const restoreSpace: RestoreSpaceApi = {
+      list: async () => [{ path: "/src/recovered.ts", mtime: 0 }],
+      readFileBytes: async () => new TextEncoder().encode("recovered"),
+      completeRestore: async (requestId) => {
+        order.push(`complete:${requestId}`)
+        return true
+      },
+    }
+    const callSpace = async <T>(callback: (api: RestoreSpaceApi) => Promise<T>) =>
+      callback(restoreSpace)
+    await reconcilePendingDevelopmentRestore(
+      { requestId: "restore-request" },
+      callSpace,
+      manager,
+      (type) => order.push(`broadcast:${type}`),
+    )
+    expect(order).toEqual([
+      "broadcast:file_deleted",
+      "broadcast:file_deleted",
+      "broadcast:file_generated",
+      "complete:restore-request",
+    ])
+    expect(Object.keys(state.generatedFilesMap)).toEqual(["src/recovered.ts"])
+
+    await expect(syncRestoredDevelopmentFiles(
+      {
+        list: async () => [{ path: "/src/unavailable.ts", mtime: 0 }],
+        readFileBytes: async () => null,
+      },
+      manager,
+      () => {},
+    )).rejects.toThrow("Could not read restored Development file /src/unavailable.ts")
+    expect(Object.keys(state.generatedFilesMap).sort()).toEqual(["src/recovered.ts"])
+  })
+
+  it("does not complete a restore when a restored file cannot be projected", async () => {
+    let state = { generatedFilesMap: {} as Record<string, FileState> }
+    const manager = new FileManager(
+      {
+        getState: () => state as unknown as BaseProjectState,
+        setState: (next: BaseProjectState) => {
+          state = next as unknown as typeof state
+        },
+        updateField: () => {},
+      } as unknown as IStateManager<BaseProjectState>,
+      () => ({}) as TemplateDetails,
+      { setOnFilesChangedCallback: () => {} } as unknown as GitVersionControl,
+    )
+    let completed = false
+    const api: RestoreSpaceApi = {
+      list: async () => [{ path: "/src/unavailable.ts", mtime: 0 }],
+      readFileBytes: async () => null,
+      completeRestore: async () => {
+        completed = true
+        return true
+      },
+    }
+
+    await expect(reconcilePendingDevelopmentRestore(
+      { requestId: "unprojected-restore" },
+      async <T>(callback: (space: RestoreSpaceApi) => Promise<T>) => callback(api),
+      manager,
+      () => {},
+    )).rejects.toThrow("Could not read restored Development file /src/unavailable.ts")
+    expect(completed).toBe(false)
+  })
+})
