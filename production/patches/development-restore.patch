@@ -0,0 +1,75 @@
+import type { FileOutputType } from "../../schemas"
+import type { IFileManager } from "../../services/interfaces/IFileManager"
+import { WebSocketMessageResponses } from "../../constants"
+
+export interface RestoreSpaceFiles {
+  list(): Promise<Array<{ path: string; mtime: number }>>
+  readFileBytes(path: string): Promise<Uint8Array | null>
+}
+
+export interface PendingDevelopmentRestore {
+  requestId: string
+}
+
+export interface RestoreSpaceApi extends RestoreSpaceFiles {
+  completeRestore(requestId: string): Promise<boolean>
+}
+
+export async function reconcilePendingDevelopmentRestore(
+  pending: PendingDevelopmentRestore,
+  callSpace: <T>(callback: (space: RestoreSpaceApi) => Promise<T>) => Promise<T>,
+  fileManager: IFileManager,
+  broadcast: (type: string, payload: unknown) => void,
+): Promise<void> {
+  const snapshot: RestoreSpaceFiles = {
+    list: () => callSpace((space) => space.list()),
+    readFileBytes: (path) => callSpace((space) => space.readFileBytes(path)),
+  }
+  await syncRestoredDevelopmentFiles(snapshot, fileManager, broadcast)
+  if (!(await callSpace((space) => space.completeRestore(pending.requestId)))) {
+    throw new Error("The restored Development tree could not be confirmed in the editor state")
+  }
+}
+
+export async function syncRestoredDevelopmentFiles(
+  space: RestoreSpaceFiles,
+  fileManager: IFileManager,
+  broadcast: (type: string, payload: unknown) => void,
+): Promise<void> {
+  const entries = await space.list()
+  const oldFiles = fileManager.getGeneratedFilesMap()
+  const files: FileOutputType[] = []
+  const decoder = new TextDecoder("utf-8", { fatal: true, ignoreBOM: false })
+  for (const entry of entries) {
+    const bytes = await space.readFileBytes(entry.path)
+    if (!bytes) throw new Error(`Could not read restored Development file ${entry.path}`)
+    try {
+      files.push({
+        filePath: entry.path.replace(/^\/+/, ""),
+        fileContents: decoder.decode(bytes),
+        filePurpose: "Restored from Development checkpoint",
+      })
+    } catch {
+      // Binary assets stay in SpaceDO and are intentionally omitted from the
+      // text-only FileManager projection used for agent context.
+    }
+  }
+  fileManager.replaceGeneratedFiles(files)
+  const nextPaths = new Set(files.map((file) => file.filePath))
+  for (const oldPath of Object.keys(oldFiles)) {
+    if (!nextPaths.has(oldPath)) {
+      broadcast(WebSocketMessageResponses.FILE_DELETED, { filePath: oldPath })
+    }
+  }
+  for (const file of files) {
+    const old = oldFiles[file.filePath]
+    if (old?.fileContents === file.fileContents) continue
+    const restored = fileManager.getGeneratedFile(file.filePath)
+    if (restored) {
+      broadcast(WebSocketMessageResponses.FILE_GENERATED, {
+        message: `Restored ${file.filePath}`,
+        file: restored,
+      })
+    }
+  }
+}
