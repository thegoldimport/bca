+import { describe, expect, it } from "vitest"
+import { FileManager } from "./FileManager"
+import type { BaseProjectState, FileState } from "../../core/state"
+import type { IStateManager } from "../interfaces/IStateManager"
+import type { TemplateDetails } from "../../../services/sandbox/sandboxTypes"
+import type { GitVersionControl } from "../../git"
+
+describe("FileManager Development restore projection", () => {
+  it("replaces stale generated files and preserves existing file purposes", () => {
+    let state = {
+      generatedFilesMap: {
+        "src/keep.ts": {
+          filePath: "src/keep.ts",
+          fileContents: "old",
+          filePurpose: "keep purpose",
+          lastDiff: "old diff",
+        },
+        "src/stale.ts": {
+          filePath: "src/stale.ts",
+          fileContents: "stale",
+          filePurpose: "stale purpose",
+          lastDiff: "",
+        },
+      } as Record<string, FileState>,
+    }
+    const stateManager = {
+      getState: () => state as unknown as BaseProjectState,
+      setState: (next: BaseProjectState) => {
+        state = next as unknown as typeof state
+      },
+      updateField: () => {},
+    } as unknown as IStateManager<BaseProjectState>
+    const git = { setOnFilesChangedCallback: () => {} } as unknown as GitVersionControl
+    const manager = new FileManager(
+      stateManager,
+      () => ({}) as TemplateDetails,
+      git,
+    )
+
+    manager.replaceGeneratedFiles([
+      { filePath: "/src/keep.ts", fileContents: "restored", filePurpose: "new purpose" },
+      { filePath: "/src/new.ts", fileContents: "new file", filePurpose: "generated" },
+    ])
+
+    expect(Object.keys(state.generatedFilesMap).sort()).toEqual(["src/keep.ts", "src/new.ts"])
+    expect(state.generatedFilesMap["src/keep.ts"]).toMatchObject({
+      filePath: "src/keep.ts",
+      fileContents: "restored",
+      filePurpose: "keep purpose",
+      lastDiff: "",
+    })
+    expect(state.generatedFilesMap["src/new.ts"]).toMatchObject({
+      fileContents: "new file",
+      filePurpose: "generated",
+    })
+  })
+})
