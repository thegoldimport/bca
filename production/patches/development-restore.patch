+import { describe, expect, it } from "vitest"
+import { env, runInDurableObject } from "cloudflare:test"
+import type { Env } from "../src/env"
+import { SpaceDO } from "../src/space/durable-object"
+import { persistDeploymentBundle, type BranchDeploymentBundle } from "../src/space/deploy-engine"
+
+const RESTORE_JOURNAL_KEY = "space:restoreJournal:v1"
+const ACTIVE_WORKSPACE_KEY = "space:activeWorkspaceNamespace"
+
+function uniqueStub(name: string) {
+  const id = env.FsHarnessDO.idFromName(`restore-${name}-${Date.now()}-${Math.random()}`)
+  return env.FsHarnessDO.get(id)
+}
+
+function inSpace<T>(
+  stub: ReturnType<typeof uniqueStub>,
+  callback: (space: SpaceDO, state: DurableObjectState) => Promise<T>,
+): Promise<T> {
+  return runInDurableObject(stub, async (_instance, state) => {
+    const space = new SpaceDO(state, env as unknown as Env)
+    const testable = space as unknown as {
+      buildBranchDeploymentFor: (
+        backend: { git: { log: (options: { ref: string; depth: number }) => Promise<Array<{ oid: string }>> } },
+        branch: string,
+      ) => Promise<BranchDeploymentBundle>
+    }
+    testable.buildBranchDeploymentFor = async (backend, branch) => {
+      const [head] = await backend.git.log({ ref: branch, depth: 1 })
+      if (!head) throw new Error("No test branch commit")
+      return {
+        branch,
+        commitHash: head.oid,
+        mainModule: "index.js",
+        modules: { "index.js": 'export default { fetch() { return new Response("test") } }' },
+        assets: {},
+        assetConfig: undefined,
+        compatibilityDate: "2025-04-01",
+      }
+    }
+    return callback(space, state)
+  })
+}
+
+async function putVersion(
+  space: SpaceDO,
+  version: string,
+  extraPath?: string,
+  binary?: Uint8Array,
+  renamedFile = false,
+  includeSpecialFiles = false,
+): Promise<string> {
+  await space.writeFile("/wrangler.jsonc", '{"main":"src/index.ts","compatibility_date":"2025-04-01"}')
+  await space.writeFile("/package.json", `{"name":"test-app","version":"${version}"}`)
+  await space.writeFile(
+    "/src/index.ts",
+    `export default { fetch() { return new Response("${version}") } }\n`,
+  )
+  if (extraPath) await space.writeFile(extraPath, `${version}:${extraPath}\n`)
+  if (binary) {
+    const writable = space as unknown as {
+      fs: { writeFileBytes: (path: string, bytes: Uint8Array) => Promise<void> }
+    }
+    await writable.fs.writeFileBytes("/assets/logo.bin", binary)
+  }
+  if (includeSpecialFiles) {
+    const writable = space as unknown as {
+      fs: {
+        symlink: (target: string, path: string) => Promise<void>
+        lstat: (path: string) => Promise<{ mode?: number }>
+        readlink: (path: string) => Promise<string>
+      }
+      backend: { fs: { mkdir: (path: string, options?: { recursive?: boolean }) => Promise<void> }; setFileMode: (path: string, mode: number) => Promise<void> }
