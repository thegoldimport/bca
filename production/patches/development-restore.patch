+function newArtifactsWorkspace() {
+  const fs = new InMemoryFs()
+  const backend = Object.assign(Object.create(ArtifactsBackend.prototype), {
+    fs,
+    overlay: fs,
+    git: createGit(fs),
+    ready: async () => {},
+    materializeAll: async () => {},
+    flushCheckpoint: async () => {},
+    fetch: async () => {},
+    fetchVerified: async () => true,
+    push: async () => true,
+    setFileMode: async (path: string, mode: number) => fs.chmod(path, mode & 0o777),
+    clearCheckpointsAfterRestore: vi.fn(async () => {}),
+    discard: async () => {},
+    isolatedRestore: false,
+  }) as ArtifactsBackend & {
+    fs: InMemoryFs
+    overlay: InMemoryFs
+    git: ReturnType<typeof createGit>
+    clearCheckpointsAfterRestore: ReturnType<typeof vi.fn>
+  }
+  return backend
+}
+
+async function copyWorkspace(source: ArtifactsBackend, destination: ArtifactsBackend): Promise<void> {
+  const paths = await source.fs.glob("/**/*")
+  for (const path of paths.sort((a, b) => a.length - b.length)) {
+    if (path === "/") continue
+    const stat = await source.fs.lstat(path)
+    if (stat.type === "directory") continue
+    const parent = path.slice(0, path.lastIndexOf("/")) || "/"
+    if (parent !== "/") await destination.fs.mkdir(parent, { recursive: true })
+    if (stat.type === "symlink") {
+      await destination.fs.symlink(await source.fs.readlink(path), path)
+    } else {
+      await destination.fs.writeFileBytes(path, await source.fs.readFileBytes(path))
+      if ((stat.mode ?? 0) & 0o111) await destination.setFileMode(path, stat.mode!)
+    }
+  }
+}
+
+async function cloneWorkspace(source: ArtifactsBackend): Promise<ArtifactsBackend> {
+  const clone = newArtifactsWorkspace()
+  await copyWorkspace(source, clone)
+  return clone
+}
