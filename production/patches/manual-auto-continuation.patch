+|| !latest.autoContinue?.enabled || latest.autoContinue.version !== preference.version
+|| latest.autoContinue.taskId !== preference.taskId) return;
+this.setThinkPendingInputs([APPROVED_CONTINUATION_PROMPT], [accepted.operationId]);
+} catch (error) {
+// Turning Off is an expected stop, not a platform error.
+const latest = await stub.getTaskLifecycle();
+if (!latest.autoContinue?.enabled || latest.autoContinue.version !== preference.version) return;
+await stub.setTaskAutoContinue(preference.taskId, false);
+this.broadcast(WebSocketMessageResponses.ERROR, {
+error: error instanceof Error ? error.message : 'Auto Continue stopped. Please try continuing manually.',
+});
+}
+}
