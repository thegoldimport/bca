diff --git a/production/vibesdk-launch/runtime-source/worker/agents/think/customer-operation.test.ts b/worker/agents/think/customer-operation.test.ts
new file mode 100644
index 0000000..47eac66
--- /dev/null
+++ b/worker/agents/think/customer-operation.test.ts
@@ -0,0 +1,122 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import agentSource from './ThinkAgent.ts?raw';
+import behaviorSource from '../core/behaviors/think.ts?raw';
+import {
+  advanceThinkTaskOperation,
+  createThinkTaskOperation,
+  createThinkTaskQueueIdentity,
+  recoverThinkTaskOperation,
+  reserveThinkTaskResource,
+  resolveThinkTaskStart,
+  resolveThinkCompletedTaskReplay,
+} from './finish-task-tool';
+
+const limits = { maxContinuations: 4, maxCredits: 250, maxElapsedMs: 900_000 };
+const savedTurnA = 'persisted-customer-turn-a';
+const savedTurnB = 'persisted-customer-turn-b';
+const operationId = (turn: string) => createThinkTaskQueueIdentity([turn]);
+
+afterEach(() => vi.useRealTimers());
+
+describe('persisted customer operation boundaries', () => {
+  it.each(['credit_limit', 'elapsed_time_limit'] as const)(
+    'starts a fresh B after A stops on %s, without changing limits or workspace',
+    (reason) => {
+      vi.useFakeTimers();
+      vi.setSystemTime(1_000_000);
+      const a = {
+        ...createThinkTaskOperation(operationId(savedTurnA), 'response-a', limits),
+        creditsConsumed: 250, modelCalls: 125, toolCalls: 200,
+        continuationCount: 4, completedPassCount: 5,
+        resourceLimitReason: reason, resourceLimitAt: 1_000_000,
+        lastOperationFingerprint: 'old-progress',
+      };
+      vi.setSystemTime(3_000_000);
+      expect(resolveThinkTaskStart(operationId(savedTurnB), 'INCOMPLETE_RESOURCE_LIMIT', a))
+        .toBe('START_NEW');
+      const b = createThinkTaskOperation(operationId(savedTurnB), 'response-b', a.limits);
+      expect(b.taskId).not.toBe(a.taskId);
+      expect(b).toMatchObject({
+        creditsConsumed: 0, modelCalls: 0, toolCalls: 0,
+        continuationCount: 0, completedPassCount: 0, startedAt: 3_000_000,
+        pendingPromptKind: 'INITIAL', lastOperationFingerprint: '',
+        availableMeteredCredits: null, meteredCreditsInitialized: false,
+      });
+      expect(b.resourceLimitReason).toBeUndefined();
+      expect(b.limits).toEqual(a.limits);
+      expect(reserveThinkTaskResource(b, 'model', 3_000_000, 2).limitExceeded).toBeUndefined();
+      // beginTask only appends/reads Think messages and current revision evidence.
+      const beginTask = agentSource.slice(agentSource.indexOf('async beginTask('),
+        agentSource.indexOf('async getTaskLifecycle('));
+      expect(beginTask).not.toMatch(/resetWorkspace|clearMessages|clearConversation|deleteBranch/);
+    },
+  );
+
+  it('keeps the same persisted identity, elapsed window and counters through continuation/recovery', () => {
+    const a = createThinkTaskOperation(operationId(savedTurnA), 'response-a', limits);
+    const used = reserveThinkTaskResource(a, 'model', a.startedAt, 2).operation;
+    const continuation = recoverThinkTaskOperation(advanceThinkTaskOperation(used), {}, a.startedAt + 100);
+    expect(continuation).toMatchObject({
+      taskId: a.taskId, startedAt: a.startedAt, creditsConsumed: 2,
+      modelCalls: 1, continuationCount: 1, pendingPromptKind: 'CONTINUATION',
+    });
+    expect(continuation.limits).toEqual(a.limits);
+  });
+
+  it('acknowledges a duplicate persisted A without a new budget, including after B', () => {
+    const a = createThinkTaskOperation(operationId(savedTurnA), 'response-a', limits);
+    expect(resolveThinkTaskStart(operationId(savedTurnA), 'RUNNING', a)).toBe('RESUME');
+    expect(resolveThinkTaskStart(operationId(savedTurnA), 'COMPLETE', a)).toBe('ACK_TERMINAL');
+    // Historical receipts are checked before current-operation selection, and
+    // the host acknowledges them without driving the newer task.
+    const usedA = { ...a, creditsConsumed: 250, continuationCount: 4, modelCalls: 125 };
+    const replay = resolveThinkCompletedTaskReplay(operationId(savedTurnA), usedA);
+    expect(replay).toMatchObject({ taskId: a.taskId, creditsConsumed: 250, continuationCount: 4, modelCalls: 125, replayOnly: true });
+    expect(resolveThinkCompletedTaskReplay(operationId(savedTurnB), usedA)).toBeUndefined();
+    expect(agentSource.indexOf('if (receipt) return receipt;'))
+      .toBeLessThan(agentSource.indexOf('const existingOperation =', agentSource.indexOf('async beginTask(')));
+    expect(agentSource).toContain('`think_completed_task:${existingOperation.taskId}`');
+    expect(behaviorSource).toContain('if (operation.replayOnly) return;');
+  });
+
+  it.each(['credit_limit', 'elapsed_time_limit', 'available_credits_limit'] as const)(
+    'preserves first terminal cause %s during later checkpoint guards',
+    (reason) => {
+      const a = {
+        ...createThinkTaskOperation(operationId(savedTurnA), 'response-a', limits),
+        resourceLimitReason: reason, resourceLimitAt: 123,
+      };
+      const checkpoint = reserveThinkTaskResource(a, 'checkpoint', a.startedAt + 999_999);
+      expect(checkpoint.limitExceeded).toBe(reason);
+      expect(checkpoint.operation.resourceLimitAt).toBe(123);
+      expect(checkpoint.operation.creditsConsumed).toBe(0);
+      expect(recoverThinkTaskOperation(checkpoint.operation).resourceLimitReason).toBe(reason);
+    },
+  );
+
+  it('records the first credit guard rather than replacing it with a later elapsed guard', () => {
+    const a = { ...createThinkTaskOperation(operationId(savedTurnA), 'response-a', limits), creditsConsumed: 250 };
+    const stopped = reserveThinkTaskResource(a, 'model', a.startedAt + 1, 2);
+    expect(stopped.limitExceeded).toBe('credit_limit');
+    expect(reserveThinkTaskResource(stopped.operation, 'checkpoint', a.startedAt + 900_000).limitExceeded)
+      .toBe('credit_limit');
+  });
+
+  it('uses the admission policy for stock account metering without increasing operation ceilings', () => {
+    expect(agentSource).toContain('if (config && isCloudflareGatewayLimitsEnabled(this.env))');
+    expect(agentSource).toContain('if (this.turnUsage?.config.llmCalls.enabled && config)');
+    const a = createThinkTaskOperation(operationId(savedTurnA), 'response-a', limits);
+    const atCeiling = { ...a, creditsConsumed: 250 };
+    expect(reserveThinkTaskResource(atCeiling, 'model', a.startedAt, 2).limitExceeded).toBe('credit_limit');
+    const metered = { ...a, availableMeteredCredits: 0, meteredCreditsInitialized: true };
+    expect(reserveThinkTaskResource(metered, 'model', a.startedAt, 2).limitExceeded)
+      .toBe('available_credits_limit');
+  });
+
+  it('reports the persisted lifecycle only for the newest queued customer operation', () => {
+    expect(behaviorSource).toContain('if (createThinkTaskQueueIdentity(queueIds.slice(-1)) === taskId)');
+    expect(behaviorSource).toContain('nativeTaskLifecycle: result.lifecycle');
+    expect(behaviorSource).toContain('reason: result.lifecycle.reason');
+    expect(behaviorSource).not.toContain('(err) => this.broadcast(WebSocketMessageResponses.ERROR, { error: err })');
+  });
+});
