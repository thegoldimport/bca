+		const { fetchMock, getPutCount } = mockFetchForMigrationError();
+
+		await expect(deployThinkBundleToPlatform({
+			accountId: 'account-1',
+			apiToken: 'token-1',
+			dispatchNamespace: 'namespace-1',
+			previewDomain: 'build-preview.cloudflare.dev',
+			appName: 'My App',
