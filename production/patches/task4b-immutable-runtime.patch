+		expect(fetchMock).toHaveBeenCalledWith(
+			`https://api.cloudflare.com/client/v4/accounts/account-1/workers/dispatch/namespaces/${NAMESPACE}/scripts/${SCRIPT_NAME}`,
+			{ method: 'GET', headers: { Authorization: 'Bearer token-1' } },
+		);
+	});
+
