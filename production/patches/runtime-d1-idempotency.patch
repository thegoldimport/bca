+import { instrumentD1WithSentry } from '@sentry/cloudflare';
+
+// D1 bindings are shared across service instances in a Worker isolate. Sentry
+// mutates prepare(), so invoking it per service constructor builds proxy chains.
+// Its statement-query instrumentation already guards first/all/run/raw; guarding
+// the binding also ensures each fresh statement's bind() is wrapped only once.
+const instrumentedBindings = new WeakMap<D1Database, D1Database>();
+
+export function instrumentD1Once(binding: D1Database): D1Database {
+    const existing = instrumentedBindings.get(binding);
+    if (existing) return existing;
+
+    const instrumented = instrumentD1WithSentry(binding);
+    // Only record successful instrumentation. Preserve the SDK's return value
+    // and recognize it too if a future SDK returns a distinct binding.
+    instrumentedBindings.set(binding, instrumented);
+    instrumentedBindings.set(instrumented, instrumented);
+    return instrumented;
+}
