+import { RpcTarget } from 'cloudflare:workers';
+import { emitThinkDiagnostic, observeThinkBoundary, withThinkDiagnosticSafety, type ThinkDiagnosticContext } from './diagnostics';
+
+/** Original RPC forwarding semantics, with metadata-only diagnostics. */
+export class ThinkStreamForwarder extends RpcTarget {
+	private nativeRequestId?: string;
+	private lastToolName?: string;
+	private lastToolCallId?: string;
+
+	constructor(
+		private readonly onChunkJson: (json: string) => void | Promise<void>,
+		private readonly onErrorCb: (message: string) => void,
+		private readonly onDoneCb: () => Promise<void>,
+		private readonly diagnosticContext: () => ThinkDiagnosticContext,
+	) { super(); }
+
+	private context(): ThinkDiagnosticContext {
+		return {
+			...this.diagnosticContext(), nativeRequestId: this.nativeRequestId,
+			toolName: this.lastToolName, toolCallId: this.lastToolCallId,
+		};
+	}
+
+	onStart(event: { requestId: string }): void {
+		withThinkDiagnosticSafety(() => { this.nativeRequestId = event.requestId; });
+		emitThinkDiagnostic('rpc.callback', 'start', () => this.context());
+	}
+
+	async onEvent(json: string): Promise<void> {
+		let chunkType: string | undefined;
+		withThinkDiagnosticSafety(() => {
+			const chunk = JSON.parse(json) as Record<string, unknown>;
+			chunkType = typeof chunk.type === 'string' ? chunk.type : undefined;
+			if (chunk.type === 'tool-input-start' || chunk.type === 'tool-input-available') {
+				this.lastToolName = typeof chunk.toolName === 'string' ? chunk.toolName : undefined;
+				this.lastToolCallId = typeof chunk.toolCallId === 'string' ? chunk.toolCallId : undefined;
+			}
+		});
+		try {
+			await this.onChunkJson(json);
+			if (chunkType === 'start-step' || chunkType === 'finish-step' || chunkType === 'tool-output-available') {
+				emitThinkDiagnostic('stream.forwarding', 'forwarded', () => ({ ...this.context(), chunkType }));
+			}
+		} catch (error) {
+			emitThinkDiagnostic('stream.forwarding', 'error', () => ({ ...this.context(), chunkType }), error);
+			throw error;
+		}
+	}
+
+	async onDone(): Promise<void> {
+		await observeThinkBoundary('rpc.callback.onDone', () => this.context(), () => this.onDoneCb());
+	}
+
+	onError(error: string): void {
+		emitThinkDiagnostic('rpc.callback.onError', 'error', () => this.context(), error);
+		try { this.onErrorCb(error); }
+		catch (cause) {
+			emitThinkDiagnostic('rpc.callback.onError.delivery', 'error', () => this.context(), cause);
+			throw cause;
+		}
+	}
+
+	onInterrupted(): void {
+		emitThinkDiagnostic('rpc.callback', 'interrupted', () => this.context());
+	}
+}
