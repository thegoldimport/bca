@@ -0,0 +1,409 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+	emitThinkDiagnostic, observeThinkBoundary, observeThinkBoundarySync,
+	serializeThinkDiagnosticError, withThinkDiagnosticSafety,
+	type ThinkDiagnosticContext,
+} from './diagnostics';
+import { ThinkStreamForwarder } from './stream-forwarder';
+import { createThinkTaskOperation, driveThinkTaskOperation, markThinkTaskChatResolved, type ThinkTaskDriverStub } from './finish-task-tool';
+
+describe('observational Think diagnostics', () => {
+	let info: ReturnType<typeof vi.spyOn>;
+	beforeEach(() => { info = vi.spyOn(console, 'info').mockImplementation(() => {}); });
+	afterEach(() => vi.restoreAllMocks());
+
+	it('retains exact safe error name/code and known internal frames without message text', () => {
+		const original = Object.assign(new Error('private RPC text'), { code: 'ERR_RPC_CANCELED' });
+		original.stack = 'Error: private stack header\n at ThinkAgent.onChatError (worker/agents/think/ThinkAgent.ts:41:2)\n at user.function (/private/home/customer.ts:99:4)';
+		const outer = new Error('private forwarding text', { cause: new Error('private wrapper text', { cause: original }) });
+		expect(serializeThinkDiagnosticError(outer)).toEqual({
+			name: 'Error',
+			cause: {
+				name: 'Error',
+				cause: {
+					name: 'Error',
+					code: 'ERR_RPC_CANCELED',
+					frames: [{ file: 'ThinkAgent.ts', line: 41, column: 2 }],
+				},
+			},
+		});
+	});
+
+	it('discards arbitrary messages, unsupported context keys, and credential-like fields', () => {
+		const secret = 'sensitive-credential-value';
+		const error = Object.assign(new Error(`password=${secret}; Bearer bearer-value https://host/path?ticket=ticket-value`), {
+			cause: new Error('private customer prompt and hidden reasoning'),
+			password: secret, input: { prompt: secret }, apiKey: secret,
+		});
+		emitThinkDiagnostic('host.stub.chat', 'error', {
+			agentId: 'agent-1',
+			password: secret,
+			reasoning: secret,
+		} as unknown as ThinkDiagnosticContext, error);
+		const text = JSON.stringify(info.mock.calls);
+		for (const value of [secret, 'bearer-value', 'ticket-value', 'private customer prompt', 'hidden reasoning']) {
+			expect(text).not.toContain(value);
+		}
+		expect(text).toContain('agent-1');
+		expect(text).toContain('"name":"Error"');
+		expect(text).not.toContain('message');
+	});
+
+	it('bounds circular and nested causes and omits AggregateError member text', () => {
+		const circular: { cause?: unknown; message: string } = { message: 'private circular message' };
+		circular.cause = circular;
+		expect(serializeThinkDiagnosticError(circular)).toEqual({
+			name: 'UnknownError',
+			cause: { circular: true },
+		});
+
+		const chain = new Error('root', {
+			cause: new Error('one', {
+				cause: new Error('two', { cause: new Error('three', { cause: new Error('four') }) }),
+			}),
+		});
+		const serialized = serializeThinkDiagnosticError(chain);
+		expect(serialized).toMatchObject({
+			name: 'Error',
+			cause: {
+				name: 'Error',
+				cause: {
+					name: 'Error',
+					cause: { name: 'Error' },
+				},
+			},
+		});
+		expect(JSON.stringify(serialized)).not.toContain('four');
+		expect(serializeThinkDiagnosticError(new AggregateError([new Error('private inner text')], 'private aggregate')))
+			.toEqual({ name: 'AggregateError' });
+	});
+
+	it('returns exact successful result and preserves exact thrown error identity', async () => {
+		const result = {};
+		expect(await observeThinkBoundary('host.stub.chat', {}, async () => result)).toBe(result);
+		const error = new DOMException('private cancellation text', 'AbortError');
+		await expect(observeThinkBoundary('host.stub.chat', {}, async () => { throw error; })).rejects.toBe(error);
+		expect(info.mock.calls.some(call => JSON.stringify(call).includes('AbortError'))).toBe(true);
+		expect(JSON.stringify(info.mock.calls)).not.toContain('private cancellation text');
+	});
+
+	it('drops diagnostics when the sink throws without changing success or error identity', async () => {
+		info.mockImplementation(() => { throw new Error('sink private failure'); });
+		expect(await observeThinkBoundary('host.stub.chat', {}, async () => 7)).toBe(7);
+		const error = new Error('original private error');
+		await expect(observeThinkBoundary('host.stub.chat', {}, async () => { throw error; })).rejects.toBe(error);
+		expect(() => observeThinkBoundarySync('operation.persistence', {}, () => { throw error; })).toThrow(error);
+	});
+
+	it('records numeric WebSocket metadata and omits every close reason', () => {
+		emitThinkDiagnostic('host.websocket', 'close', {
+			agentId: 'agent-1', closeCode: 1006, wasClean: false, readyState: 3,
+			closeReason: 'Bearer ws-private-token https://host/ws?ticket=private',
+		} as unknown as ThinkDiagnosticContext);
+		expect(info.mock.calls[0][1]).toMatchObject({ closeCode: 1006, wasClean: false, readyState: 3 });
+		expect(JSON.stringify(info.mock.calls)).not.toContain('ws-private-token');
+		expect(JSON.stringify(info.mock.calls)).not.toContain('ticket=private');
+		expect(info.mock.calls[0][1]).not.toHaveProperty('closeReason');
+	});
+
+	it('attributes tool and synchronous persistence failures without retrying', async () => {
+		const execute = vi.fn(async () => { throw new Error('private write failure'); });
+		await expect(observeThinkBoundary('tool.execute-and-evidence', {
+			toolName: 'write', toolCallId: 'call-1',
+		}, execute)).rejects.toThrow('private write failure');
