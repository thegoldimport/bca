--- /dev/null
+++ b/worker/agents/think/task-lifecycle-status.ts
@@ -0,0 +1,20 @@
+import type { ThinkTaskLifecycle } from './finish-task-tool';
+
+const statuses = new Set(['RUNNING', 'COMPLETE', 'BLOCKED', 'INCOMPLETE_RESOURCE_LIMIT']);
+const resourceReasons = new Set([
+	'credit_limit', 'model_call_limit', 'tool_call_limit', 'elapsed_time_limit',
+	'available_credits_limit', 'continuation_budget_exhausted',
+]);
+
+/** Owner-visible metadata from the existing native lifecycle, never its summary. */
+export function projectNativeTaskLifecycle(lifecycle: ThinkTaskLifecycle) {
+	if (!statuses.has(lifecycle.status) || !Number.isFinite(lifecycle.updatedAt)) {
+		throw new Error('Native task lifecycle is unavailable.');
+	}
+	return {
+		status: lifecycle.status,
+		updatedAt: lifecycle.updatedAt,
+		...(lifecycle.reason && resourceReasons.has(lifecycle.reason)
+			? { reason: lifecycle.reason } : {}),
+	};
+}
