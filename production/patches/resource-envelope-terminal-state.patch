+import { describe, expect, it } from 'vitest';
+import { projectNativeTaskLifecycle } from './task-lifecycle-status';
+
+describe('native owner lifecycle projection', () => {
+	it('uses native terminal state without leaking its summary', () => {
+		const native = { status: 'INCOMPLETE_RESOURCE_LIMIT' as const, reason: 'credit_limit',
+			updatedAt: 1234, summary: 'private details' };
+		expect(projectNativeTaskLifecycle(native)).toEqual({
+			status: 'INCOMPLETE_RESOURCE_LIMIT', reason: 'credit_limit', updatedAt: 1234,
+		});
+		expect(native.status).toBe('INCOMPLETE_RESOURCE_LIMIT');
+	});
+	it('excludes arbitrary reason strings', () => {
+		expect(projectNativeTaskLifecycle({
+			status: 'BLOCKED', updatedAt: 1, summary: 'private', reason: 'private text',
+		})).toEqual({ status: 'BLOCKED', updatedAt: 1 });
+	});
+});
