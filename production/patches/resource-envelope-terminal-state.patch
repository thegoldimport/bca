+} from './finish-task-tool';
+
+describe('Think operation config refresh', () => {
+	it('models the configured-operation contract: preserves config, recovers old limits, applies 250 to the next operation', () => {
+		const originalConfig = {
+			userId: 'owner-123',
+			model: {
+				baseURL: 'https://gateway.example/compat',
+				apiKey: 'provider-key',
+				modelName: 'model-a',
+				headers: {
