+			},
+			systemPrompt: 'Project context and system instructions.',
+			previewUrl: 'https://preview.example/app',
+			operationLimits: {
+				maxContinuations: 4,
+				maxModelCalls: 17,
+				maxToolCalls: 33,
+				maxElapsedMs: 900_000,
+				maxCredits: 100,
+			},
+		};
+		const configured = {
+			...originalConfig,
+			operationLimits: {
+				...originalConfig.operationLimits,
+				...parseThinkOperationLimits({ maxCredits: 250 }),
+			},
+		};
+
+		const oldOperation = {
+			...createThinkTaskOperation('existing-owner-task', 'conversation-1', originalConfig.operationLimits),
+			modelCalls: 7,
+			toolCalls: 9,
+			creditsConsumed: 14,
+		};
+		expect(configured).toMatchObject({
+			userId: 'owner-123',
+			model: {
+				apiKey: 'provider-key',
+				headers: {
+					Authorization: 'Bearer provider-auth',
+					'cf-aig-authorization': 'Bearer gateway-auth',
+				},
+			},
+			systemPrompt: 'Project context and system instructions.',
+			previewUrl: 'https://preview.example/app',
+			operationLimits: {
+				maxContinuations: 4,
+				maxModelCalls: 17,
+				maxToolCalls: 33,
+				maxElapsedMs: 900_000,
+				maxCredits: 250,
+			},
+		});
+		const recovered = recoverThinkTaskOperation(oldOperation, configured.operationLimits);
+		expect(recovered).toMatchObject({
+			limits: originalConfig.operationLimits,
+			modelCalls: 7,
+			toolCalls: 9,
+			creditsConsumed: 14,
+		});
+		expect(createThinkTaskOperation(
+			'next-owner-task',
+			'conversation-2',
+			configured.operationLimits,
+		).limits).toEqual({
+			...originalConfig.operationLimits,
+			maxCredits: 250,
+		});
+	});
+
+	it('checks source wiring (not rendered SDK behavior) for env refresh before terminal owner-task return', () => {
+		const getter = thinkBehaviorSource.match(
+			/private operationLimitsFromEnvironment\(\)\s*\{[\s\S]*?\n\t\}/,
+		)?.[0];
+		expect(getter).toContain('return parseThinkOperationLimits({');
+		for (const [limit, environmentName] of [
+			['maxContinuations', 'THINK_OPERATION_MAX_CONTINUATIONS'],
+			['maxModelCalls', 'THINK_OPERATION_MAX_MODEL_CALLS'],
+			['maxToolCalls', 'THINK_OPERATION_MAX_TOOL_CALLS'],
+			['maxElapsedMs', 'THINK_OPERATION_MAX_ELAPSED_MS'],
+			['maxCredits', 'THINK_OPERATION_MAX_CREDITS'],
+		]) {
+			expect(getter).toContain(`${limit}: env.${environmentName}`);
+		}
+
+		const runPrompt = thinkBehaviorSource.match(
+			/private async runPrompt\([\s\S]*?(?=\n\t(?:private|protected|public|override)\s|\n\})/,
+		)?.[0];
+		expect(runPrompt).toBeDefined();
+		const refreshIndex = runPrompt!.indexOf('await stub.configureOperationLimits(this.operationLimitsFromEnvironment());');
+		const beginIndex = runPrompt!.indexOf('await stub.beginTask(taskId');
+		const terminalCheckIndex = runPrompt!.indexOf("if (initialLifecycle.status !== 'RUNNING') return;");
+		const driverIndex = runPrompt!.indexOf('driveThinkTaskOperation({');
+		expect(refreshIndex).toBeGreaterThanOrEqual(0);
+		expect(refreshIndex).toBeLessThan(beginIndex);
+		expect(beginIndex).toBeLessThan(terminalCheckIndex);
+		expect(terminalCheckIndex).toBeLessThan(driverIndex);
+
+		const configureLimits = thinkAgentSource.match(
+			/async configureOperationLimits\([\s\S]*?\n\t\}/,
+		)?.[0];
+		expect(configureLimits).toContain('...config');
+		expect(configureLimits).toContain('...config.operationLimits');
+		expect(configureLimits).toContain('...parseThinkOperationLimits(limits)');
+		expect(configureLimits).toContain('operationLimits: { ...config.operationLimits, ...parseThinkOperationLimits(limits) }');
+	});
+});
