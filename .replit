modules = ["web", "nodejs-22", "postgresql-16", "python-base-3.13"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
publicDir = "dist/public"
run = ["node", "./dist/index.cjs"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
stack = "MOCKUP_JS"
mockupState = "FULLSTACK"

[userenv]

[userenv.shared]
VITE_API_URL = "https://ai-build-studio.replit.app"
VIBESDK_RUNTIME_URL = "https://buildcustom-vibesdk-staging.thegoldimport.workers.dev"
BUILDCUSTOM_APPS_DOMAIN = "apps.buildcustom.ai"
CLOUDFLARE_ACCOUNT_ID = "03ef1e6e42498920987f07059e107538"
CLOUDFLARE_ROUTES_KV_NAMESPACE_ID = "d6e19823343e46d3965ad167775afb30"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
